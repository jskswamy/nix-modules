# display configuration
# auto-switches based on macOS appearance (System Settings → Appearance → Auto)
# run `ghostty +list-themes` to preview themes interactively
config-file = ?~/.config/ghostty/theme.conf
# font, cell size, bold/italic, cursor, copy-on-select and option-as-alt are
# shared with the other terminals (nix-modules modules/terminal).
config-file = ?~/.config/ghostty/terminal.conf
# other theme pairs to try:
#theme = light:Modus Operandi Tinted,dark:Modus Vivendi
#theme = light:Catppuccin Latte,dark:Catppuccin Mocha
#theme = light:Rose Pine Dawn,dark:Rose Pine Moon
#theme = light:Gruvbox Material Light,dark:Gruvbox Material Dark
#theme = light:Everforest Light,dark:Everforest Dark
#theme = light:One Half Light,dark:One Half Dark
#theme = light:Tokyo Night Light,dark:Tokyo Night

# font configuration - family and size come from terminal.conf
#font-variation = wght=450

# Font rendering optimizations for sharper text
# (freetype-load-flags dropped — no-op on macOS, Ghostty uses CoreText there)
grapheme-width-method = "unicode"
font-thicken = true

# Adjustments for better character clarity and spacing
adjust-font-baseline = 0

# Additional font rendering tweaks for Alacritty-like sharpness
font-shaping-break = cursor

bold-color = bright

# Enhanced rendering for pixel-perfect display
alpha-blending = "linear-corrected"
minimum-contrast = 3

# Color space optimization for better color accuracy
window-colorspace = "srgb"

# behavior - Performance optimized
confirm-close-surface = false
unfocused-split-opacity = 0.7
background-opacity = 1.0
background-blur = false
maximize = true
scrollback-limit-lines = 50000

# shell related tweaks - Enhanced for terminfo handling
shell-integration = "fish"
shell-integration-features = "cursor,title,sudo"

# macos specific tweaks. transparent, not hidden: hidden also strips the
# traffic-light buttons, and a maximized window's frame is barely visible,
# so a decorated window still looks empty-handed. transparent gives a real
# titlebar with traffic lights to grab whenever decorations are on.
macos-titlebar-style = "transparent"
macos-auto-secure-input = true
macos-titlebar-proxy-icon = visible

# =============================================================================
# GHOSTTY KEYBINDINGS (Ctrl+b prefix)
# =============================================================================
# Ctrl+b for Ghostty native (same as tmux prefix). Not ctrl+a — herdr uses
# ctrl+a as its own prefix, and Ghostty is herdr's host terminal.
#
# The keys after the prefix are shared with Rex and generated into
# terminal.conf from nix-modules terminal.keys (override per app with
# tools.ghostty.keys):
#
#   v or |       Split right          -            Split down
#   h/j/k/l      Go to split          tab or '     Next split
#   shift+tab ;  Previous split       x            Close split
#   z            Zoom split           0            Equalize splits
#   r            Resize mode (h/j/k/l repeat, Esc exits)
#   c            New tab              n / p        Next / previous tab
#   , or T       Rename tab           X            Close tab
#
# Kept here, Ghostty-only:
#   Ctrl+b 1-9   Go to tab 1-9
#   Ctrl+b `     Toggle quick terminal (dropdown)
# =============================================================================

# resize key table entered by ctrl+b>r (generated); repeat h/j/k/l, Esc exits
keybind = resize/h=resize_split:left,50
keybind = resize/j=resize_split:down,50
keybind = resize/k=resize_split:up,50
keybind = resize/l=resize_split:right,50
keybind = resize/escape=deactivate_key_table

# tabs by number
keybind = ctrl+b>1=goto_tab:1
keybind = ctrl+b>2=goto_tab:2
keybind = ctrl+b>3=goto_tab:3
keybind = ctrl+b>4=goto_tab:4
keybind = ctrl+b>5=goto_tab:5
keybind = ctrl+b>6=goto_tab:6
keybind = ctrl+b>7=goto_tab:7
keybind = ctrl+b>8=goto_tab:8
keybind = ctrl+b>9=goto_tab:9

# quick terminal
keybind = ctrl+b>backquote=toggle_quick_terminal

# working directory
window-inherit-working-directory = true

# window styling — decorationless for maximum terminal space. none removes
# the frame, borders and rounded corners entirely; on macOS it also disables
# native tabs (enforced by the system). Splits and the tmux-style prefix are
# unaffected. There is no runtime toggle: macOS 1.4 does not implement the
# toggle_window_decorations action (GTK only), so getting decorations back
# means changing window-decoration and opening a new window (super+shift+,
# reloads); the transparent titlebar style then gives a real titlebar with
# traffic lights to drag. A small balanced padding keeps text off the window
# edges and centers the cell grid so the leftover columns don't rag one side.
window-decoration = none
window-padding-x = 10,10
window-padding-y = 10,10
window-padding-balance = true
keybind = alt+backspace=text:\x1b\x7f

# disable cmd+k clear (use ctrl+l instead)
keybind = super+k=unbind

# BEGIN herdr-agent-quota font
font-codepoint-map = U+E1A0-U+E1B6="Herdr Agent Icons Max"
font-codepoint-map = U+E1C0-U+E1C5="Herdr Agent Icons Max"
# END herdr-agent-quota font
